{
  "name": "irrigation_system",
  "version": "2.0.0",
  "description": "Raspberry Pi based automated garden irrigation system",
  "main": "index.js",
  "scripts": {
    "build": "cd client && npm run build",
    "start": "npm run build && node index.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "npx eslint index.js client/src/**/*.js",
    "lint:js-fix": "npx eslint *.js  --fix",
    "lint:css": "npx stylelint client/src/styles/*.css",
    "lint:css-fix": "npx stylelint --fix client/src/styles/*.css"
  },
  "keywords": [],
  "author": "Chris Lamb",
  "license": "ISC",
  "dependencies": {
    "dayjs": "^1.11.5",
    "express": "^4.17.1",
    "highcharts": "^9.2.0",
    "highcharts-react-official": "^3.0.0",
    "node-cron": "^3.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-scripts": "4.0.3",
    "rpi-gpio": "^2.1.7",
    "socket.io": "^4.1.3",
    "tinydb": "^0.1.0"
  },
  "devDependencies": {
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^4.0.0",
    "stylelint": "^14.8.0",
    "stylelint-config-standard": "^25.0.0",
    "stylelint-order": "^5.0.0"
