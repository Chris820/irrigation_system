{
  "root": true,
  "extends": [
    "eslint:recommended",
    "react-app"
  ],
  "rules": {
    "quotes": ["error", "single"],
    "func-names": ["warn", "as-needed"]
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
